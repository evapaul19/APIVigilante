# APIVigilante environment template.
# Copy this file to .env, fill in real values, and never commit .env.

# PostgreSQL connection used by both the application and docker compose.
# Use the same password as POSTGRES_PASSWORD. If the database volume already
# exists, use its existing password rather than changing it here. URL-encode
# special characters in the password portion of DATABASE_URL.
# For local processes use localhost. Inside docker compose the services use the
# `postgres` hostname, which compose injects automatically.
DATABASE_URL=postgresql+psycopg://api_security:CHANGE_ME@localhost:5432/api_security
POSTGRES_PASSWORD=CHANGE_ME

# Host ports for docker compose. Set POSTGRES_PORT=5433 when another PostgreSQL
# already listens on 5432.
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=8080

# Frontend API base baked in at build time. The default /api uses the nginx
# same-origin proxy bundled with the frontend image. Use an absolute URL only
# when serving the frontend separately from the compose stack.
# VITE_API_BASE_URL=/api

# Optional browser origins allowed to call the API. Defaults to the local
# Vite origins http://localhost:5173 and http://127.0.0.1:5173.
# In production, set this to the exact frontend origin(s), comma-separated.
# APIVIGILANTE_CORS_ORIGINS=https://app.example.com

# Optional: add exact origins for active checks without editing source code.
# Comma-separated scheme://host[:port] values only; paths are ignored as
# invalid. The default VAmPI-compatible origin remains allowlisted.
# APIVIGILANTE_AUTHORIZED_ORIGINS=https://api.example.com

# Optional: allow per-assessment active testing of public, non-allowlisted
# targets when the request also sets authorized_for_active_testing=true.
# Leave unset unless you intend to allow that operator-level capability.
# APIVIGILANTE_ALLOW_USER_AUTHORIZED_TARGETS=1

# Optional: enable exact local test origins. Leave unset for normal operation.
# When APIVIGILANTE_TEST_TARGET_ORIGINS is set, it replaces the bundled
# http://127.0.0.1:5001 default. Paths are not allowed.
# APIVIGILANTE_ENABLE_TEST_TARGET=1
# APIVIGILANTE_TEST_TARGET_ORIGINS=http://127.0.0.1:5001,http://127.0.0.1:5010

# Optional LLM classification. Uncomment exactly one key.
# If no key is configured, run assessments with classify=false.
# GEMINI_API_KEY=CHANGE_ME
# OPENROUTER_API_KEY=CHANGE_ME
# LLM_PROVIDER=google
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# BFLA requires an existing higher-privileged identity on the target.
# Leave these unset to skip BFLA; do not commit real credentials.
VAMPI_ADMIN_USERNAME=
VAMPI_ADMIN_PASSWORD=

# Optional API bind settings used by the api-security-system entry point.
# API_HOST=127.0.0.1
# API_PORT=8000

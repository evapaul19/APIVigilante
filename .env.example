# APIVigilante environment template.
# Copy this file to .env, fill in real values, and never commit .env.

# PostgreSQL connection used by both the application and docker compose.
# Use the same password as POSTGRES_PASSWORD. If the database volume already
# exists, use its existing password rather than changing it here. URL-encode
# special characters in the password portion of DATABASE_URL.
DATABASE_URL=postgresql+psycopg://api_security:CHANGE_ME@localhost:5432/api_security
POSTGRES_PASSWORD=CHANGE_ME

# Optional: authorize only the isolated local test API at
# http://127.0.0.1:5001. Leave unset for normal operation.
# APIVIGILANTE_ENABLE_TEST_TARGET=1

# Optional LLM classification. Uncomment exactly one key.
# If no key is configured, run assessments with classify=false.
# GEMINI_API_KEY=CHANGE_ME
# OPENROUTER_API_KEY=CHANGE_ME
# LLM_PROVIDER=google
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# BFLA requires an existing higher-privileged identity on the target.
# Leave these unset to skip BFLA; do not commit real credentials.
VAMPI_ADMIN_USERNAME=
VAMPI_ADMIN_PASSWORD=

# Optional API bind settings used by the api-security-system entry point.
# API_HOST=127.0.0.1
# API_PORT=8000
